{
  "builders": [
    {
      "type": "qemu",
      "iso_url": "https://ftp.hostserver.de/pub/OpenBSD/snapshots/amd64/install62.iso",
      "iso_checksum": "e5d05c34a03bad4f972fcb2e5245e221eca1ffde21c59b3433f536a710c3d6d4",
      "iso_checksum_type": "sha256",
      "ssh_username": "root",
      "accelerator": "kvm",
      "disk_size": 102400,
      "format": "qcow2",
      "headless": true,
      "ssh_username": "root",
      "ssh_password": "root",
      "ssh_port": 22,
      "ssh_wait_timeout": "3000s",
      "http_directory": "httpsrv",
      "http_port_min": 8557,
      "http_port_max": 8557,
      "vnc_port_min": 5979,
      "vnc_port_max": 5979,
      "shutdown_command": "echo '/sbin/halt -p' > shutdown.sh; sh 'shutdown.sh'",
      "boot_wait": "30s",
      "boot_command": [
        "a<enter><wait10><wait10>",
        "cd /<enter><wait>autoinstall<enter><wait10>",
        "http://10.0.2.2:8557/install.conf<enter>",
        "<wait4m>",
        "root<enter><wait>penis<enter><wait>",
        "sed -i '/PermitRoot/ s/no/yes/' /etc/ssh/sshd_config<enter>",
        "rcctl restart sshd<enter><wait>",
        "exit<enter>"
      ]
    }
  ],
  "provisioners": [
    {
      "type": "shell-local",
      "command": "notify-send -u critical packer 'build finished'"
    }
  ]
}
