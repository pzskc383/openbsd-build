{
  "variables": {
    "answers": "{{env `ANSWERS`}}",
    "mirror": "{{env `MIRROR`}}",
    "anoncvs": "{{env `ANONCVS`}}",
    "version": "{{env `VERSION`}}",
    "iso_name": "{{env `ISO_NAME`}}",
    "iso_path": "{{env `ISO_PATH`}}",
    "root_password": "{{env `ROOT_PASSWORD`}}"
  },
  "builders": [
    {
      "type": "qemu",
      "iso_url": "{{user `mirror`}}/pub/OpenBSD/{{user `iso_path`}}/amd64/{{user `iso_name`}}",
      "iso_checksum_url": "{{user `mirror`}}/pub/OpenBSD/{{user `iso_path`}}/amd64/SHA256",
      "iso_checksum_type": "sha256",
      "iso_target_path": "iso/{{user `iso_name`}}",
      "output_directory": "output",
      "vm_name": "obsd-build.img",
      "accelerator": "kvm",
      "disk_size": 102400,
      "disk_compression": true,
      "format": "qcow2",
      "headless": false,
      "ssh_username": "root",
      "ssh_password": "{{user `root_password`}}",
      "ssh_port": 22,
      "ssh_wait_timeout": "3000s",
      "http_directory": "packer_httproot",
      "http_port_min": 8557,
      "http_port_max": 8557,
      "vnc_port_min": 5979,
      "vnc_port_max": 5979,
      "shutdown_command": "halt -p",
      "boot_wait": "30s",
      "boot_command": [
        "a<enter><wait15s>",
        "http://10.0.2.2:8557/install-{{user `version`}}<enter><wait2s>",
        "i<enter><wait2s>",
        "<wait4m>",
        "exit<enter>"
      ]
    }
  ]
}
