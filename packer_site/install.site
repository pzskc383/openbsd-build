#!/bin/sh
set -e -u
set -x
echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN1YdxBpNlzxDqfJyw/QKow1F+wvG9hXGoqiysfJOn5Y vagrant insecure public key" >> /root/.ssh/authorized_keys
echo "set -x" >> /etc/rc.firsttime
echo "mount -orw -u /" >> /etc/rc.firsttime
echo "mount -orw -u /usr" >> /etc/rc.firsttime
echo "pkill reorder_kernel" >> /etc/rc.firsttime
echo "sed -e 's/.checkfs/#checkfs/g' /usr/sbin/syspatch > /root/syspatch" >> /etc/rc.firsttime
echo "ksh -x /root/syspatch" >> /etc/rc.firsttime
echo "rm /root/syspatch" >> /etc/rc.firsttime
echo "ksh -x /usr/sbin/syspatch" >> /etc/rc.firsttime
echo "reboot" >> /etc/rc.firsttime
